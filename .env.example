# ---- Runtime ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated list of origins allowed to call the API / connect via Socket.IO
CORS_ORIGIN=http://localhost:5173

# ---- Datastores (defaults match docker-compose.yml) ----
# Host ports docker-compose publishes. Change them if 5432/6379 are already taken on your machine
# (then update DATABASE_URL / REDIS_URL below to match).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=3000
WEB_HOST_PORT=8080
DATABASE_URL=postgresql://dialer:dialer@localhost:5432/mini_dialer
DB_POOL_SIZE=20
REDIS_URL=redis://localhost:6379/0

# ---- Security ----
# Clients must send this in the X-API-Key header on /api/*
API_KEY=change-me-dev-api-key
# Shared secret used to verify X-Signature (HMAC-SHA256) on telephony webhooks
WEBHOOK_SECRET=change-me-webhook-secret

# ---- Global rate limit (per IP, fixed window) ----
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=600

# ---- Dialer worker ----
DIALER_POLL_INTERVAL_MS=500
# Hard cap of leads claimed per campaign per tick (CPS limit still applies)
DIALER_BATCH_SIZE=20
# Minimum delay between two attempts on the same lead
DIALER_RETRY_DELAY_SEC=60
# Reaper: leads/calls stuck longer than this are recovered
REAPER_INTERVAL_MS=30000
STUCK_DIALING_MINUTES=5
# An answered call with no "completed" event after this long is force-failed (agent released)
MAX_CALL_MINUTES=60

# ---- Mock providers ----
# If set, the mock telephony provider POSTs signed events back to this URL (used by the simulator)
MOCK_TELEPHONY_WEBHOOK_URL=http://localhost:3000/api/webhooks/call-events
# Probability [0..1] that the mock STT / LLM call fails (proves BullMQ retries)
MOCK_PROVIDER_FAILURE_RATE=0.1
# Scales mock call durations (1 = 2-10s talk time); lower speeds up the simulation
MOCK_TELEPHONY_SPEED=1

# ---- Summary worker ----
SUMMARY_WORKER_CONCURRENCY=5
# Stats cache TTL
STATS_CACHE_TTL_SEC=30
