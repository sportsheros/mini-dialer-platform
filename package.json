{
  "name": "mini-dialer-platform",
  "version": "1.0.0",
  "description": "AI-assisted outbound contact-center backend: campaigns, predictive dialer, atomic agent routing, post-call summaries.",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:dialer": "node dist/workers/dialer.worker.js",
    "start:summary": "node dist/workers/summary.worker.js",
    "worker:dialer": "ts-node --transpile-only src/workers/dialer.worker.ts",
    "worker:summary": "ts-node --transpile-only src/workers/summary.worker.ts",
    "typeorm": "typeorm-ts-node-commonjs -d src/db/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:run:prod": "typeorm -d dist/db/data-source.js migration:run",
    "seed": "ts-node --transpile-only src/db/seed.ts",
    "simulate": "ts-node --transpile-only scripts/simulate-load.ts",
    "concurrency:check": "ts-node --transpile-only scripts/concurrency-check.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "author": "jeetbeniwal12",
  "license": "MIT",
  "dependencies": {
    "bullmq": "^6.3.9",
    "dotenv": "^18.0.4",
    "express": "^4.22.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.4",
    "typeorm": "^0.3.31",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.6",
    "typescript-eslint": "^8.70.1"
  }
}
