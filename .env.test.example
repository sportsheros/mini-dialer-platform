# Copy to .env.test. Used automatically when NODE_ENV=test (jest sets it).
NODE_ENV=test
PORT=0
LOG_LEVEL=silent
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://dialer:dialer@localhost:5432/mini_dialer_test
DB_POOL_SIZE=20
REDIS_URL=redis://localhost:6379/1
API_KEY=test-api-key
WEBHOOK_SECRET=test-webhook-secret
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=100000
DIALER_POLL_INTERVAL_MS=50
DIALER_BATCH_SIZE=50
DIALER_RETRY_DELAY_SEC=0
MOCK_TELEPHONY_WEBHOOK_URL=
MOCK_PROVIDER_FAILURE_RATE=0
